# ---- Telegram -------------------------------------------------------------
# From @BotFather.
BOT_TOKEN=123456789:AA...

# The only account allowed to use the tracker. Get it from @userinfobot.
ALLOWED_TELEGRAM_ID=123456789

# Public https URL the Mini App is served from (the bot's WebApp button opens
# this). On Railway it is your service's generated domain.
WEBAPP_URL=https://your-app.up.railway.app

# ---- Google Sheets --------------------------------------------------------
# The id from the spreadsheet URL:
# https://docs.google.com/spreadsheets/d/<THIS PART>/edit
SPREADSHEET_ID=1AbC...

# The service account key, as a single line of JSON. Paste the whole file
# contents. Share the spreadsheet with this account's client_email (Editor).
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# ---- Optional -------------------------------------------------------------
# Seconds a dashboard read is cached (0 disables caching).
CACHE_TTL_SECONDS=45

# How long a Telegram initData payload stays valid, in seconds.
INIT_DATA_MAX_AGE=86400

# Evening reminder when today's check-in is still empty.
REMINDER_ENABLED=1
REMINDER_HOUR=21
REMINDER_MINUTE=0
REMINDER_TZ=Asia/Almaty

# Where the built frontend lives, relative to the process working directory.
STATIC_DIR=frontend/dist

# Only needed when the frontend is hosted on a different origin.
CORS_ORIGINS=

# Tab names, if they were ever renamed in the spreadsheet.
SHEET_FINANCE=Финансы
SHEET_BODY=Тело
SHEET_JOBS=Работа
SHEET_HABITS=Привычки
